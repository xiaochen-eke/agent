# live_agent 环境变量示例 —— 复制为 .env 并填入真实值
# transcribe.py / dify_brain.py / native_agent.py 会自动加载同目录下的 .env

# 智谱 API Key（open.bigmodel.cn 创建，用于 GLM-4-Voice 语音理解 & native_agent 的 GLM）
ZHIPU_API_KEY=

# 可选：Dify 工作流相关（dify_brain.py 已有默认值，一般无需改）
# DIFY_API_URL=http://127.0.0.1/v1/workflows/run
# DIFY_API_KEY=app-xxxx
# DIFY_FILES_UPLOAD_URL=http://127.0.0.1/v1/files/upload

# 可选：生存目标 & 状态服务
# DST_GOAL=我想活到冬天
# DST_STATE_API=http://127.0.0.1:5002

# 可选：实时语音（realtime_voice.py）
# DST_VOICE_HOTKEY=f9            # 按住说话热键
# DST_TTS_VOICE=zh-CN-XiaoxiaoNeural   # 播报音色（edge-tts）
# DST_VAD_SILENCE_MS=700         # 静音多久判定「说完」
# DST_VAD_MIN_MS=350             # 短于此的片段丢弃
# DST_VAD_ENERGY_RATIO=4.0       # 语音阈值 = 噪声RMS × 此倍数（越大越不敏感）
